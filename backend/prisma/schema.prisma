// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  username             String               @unique
  password             String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  twilioPhoneNumbers   twilioPhoneNumber[]  // plural for clarity
  messages             Message[]
}

model twilioPhoneNumber {
  id                  String    @id @default(cuid())
  twilioAuthToken     String    // store encrypted in app
  twilioAccountSid    String
  twilioPhoneNumber   String    @unique
  isPrimary           Boolean?   @default(false)
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  messages            Message[]
}

model Message {
  id                  String    @id @default(cuid())
  messageSid          String    @unique
  accountSid          String
  from                String
  to                  String
  body                String
  numMedia            Int       @default(0)
  mediaUrl            String?
  messageStatus       String    @default("queued")
  errorCode           String?
  errorMessage        String?
  timestamp           DateTime  @default(now())
  statusTimestamp     DateTime?
  direction           String    // "inbound" or "outbound-api"
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  twilioPhoneNumberId String
  twilioPhoneNumber   twilioPhoneNumber @relation(fields: [twilioPhoneNumberId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
