generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  username             String               @unique
  password             String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  twilioPhoneNumbers   twilioPhoneNumber[]
  messages             Message[]
  scheduledMessages    ScheduledMessage[]   // NEW: relation
}

model twilioPhoneNumber {
  id                  String    @id @default(cuid())
  twilioAuthToken     String
  twilioAccountSid    String
  twilioPhoneNumber   String    @unique
  isPrimary           Boolean?   @default(false)
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  messages            Message[]
  scheduledMessages   ScheduledMessage[]   // NEW: relation
}

model Message {
  id                  String    @id @default(cuid())
  messageSid          String    @unique
  accountSid          String
  from                String
  to                  String
  body                String
  numMedia            Int       @default(0)
  mediaUrl            String?
  messageStatus       String    @default("queued")
  errorCode           String?
  errorMessage        String?
  timestamp           DateTime  @default(now())
  statusTimestamp     DateTime?
  direction           String
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  twilioPhoneNumberId String
  twilioPhoneNumber   twilioPhoneNumber @relation(fields: [twilioPhoneNumberId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ScheduledMessage {
  id                  String   @id @default(cuid())
  to                  String
  from                String
  body                String
  sendAt              DateTime
  sent                Boolean  @default(false)
  failed              Boolean  @default(false)
  errorMessage        String?
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  twilioPhoneNumberId String?
  twilioPhoneNumber   twilioPhoneNumber? @relation(fields: [twilioPhoneNumberId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
