generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MessageDirection {
  inbound
  outbound
}

model User {
  id                   String               @id @default(cuid())
  username             String               @unique
  password             String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  twilioPhoneNumbers   TwilioPhoneNumber[]
  messages             Message[]
  scheduledMessages    ScheduledMessage[]
  messageForwardings   MessageForwarding[]
  contacts             Contact[]
}

model TwilioPhoneNumber {
  id                   String               @id @default(cuid())
  twilioAuthToken      String
  twilioAccountSid     String
  twilioPhoneNumber    String               @unique
  isPrimary            Boolean?             @default(false)
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  messages             Message[]
  scheduledMessages    ScheduledMessage[]
}

model Message {
  id                   String               @id @default(cuid())
  messageSid           String               @unique
  accountSid           String
  from                 String
  to                   String
  body                 String
  numMedia             Int                  @default(0)
  mediaUrl             String?
  messageStatus        String               @default("queued")
  errorCode            String?
  errorMessage         String?
  timestamp            DateTime             @default(now())
  statusTimestamp      DateTime?
  direction            MessageDirection
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  twilioPhoneNumberId  String
  twilioPhoneNumber    TwilioPhoneNumber    @relation(fields: [twilioPhoneNumberId], references: [id])
  forwarded            Boolean              @default(false)
  forwardedTo          String?              // If forwarded, the number it was sent to
  originalMessageId    String?              // For linking back to the original
  originalMessage      Message?             @relation("ForwardedFrom", fields: [originalMessageId], references: [id])
  forwardedMessages    Message[]            @relation("ForwardedFrom")
  originalForwardings  MessageForwarding[] @relation("OriginalMessage")
  forwardedForwardings MessageForwarding[] @relation("ForwardedMessage")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([messageSid])
  @@index([userId])
  @@index([twilioPhoneNumberId])
}

model ScheduledMessage {
  id                   String               @id @default(cuid())
  to                   String
  from                 String
  body                 String
  sendAt               DateTime
  sent                 Boolean              @default(false)
  failed               Boolean              @default(false)
  errorMessage         String?
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  twilioPhoneNumberId  String?
  twilioPhoneNumber    TwilioPhoneNumber?   @relation(fields: [twilioPhoneNumberId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([sendAt])
  @@index([userId])
}

model MessageForwarding {
  id                String   @id @default(cuid())
  originalMessageId String
  forwardedMessageId String
  forwardedAt       DateTime @default(now())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  originalMessage   Message  @relation("OriginalMessage", fields: [originalMessageId], references: [id])
  forwardedMessage  Message  @relation("ForwardedMessage", fields: [forwardedMessageId], references: [id])

  @@index([originalMessageId])
  @@index([forwardedMessageId])
  @@index([userId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
  @@index([userId])
}
